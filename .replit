modules = ["nodejs-20", "python-3.11"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = ".venv/bin/python -m uvicorn api:app --host 0.0.0.0 --port 8000"

[[ports]]
localPort = 8000
externalPort = 80

[deployment]
deploymentTarget = "autoscale"
build = ["sh", "-c", "python -m venv .venv && PIP_CONFIG_FILE=/dev/null .venv/bin/python -m pip install -r requirements.txt && cd frontend && npm ci && npm run build"]
run = ["sh", "-c", ".venv/bin/python -m uvicorn api:app --host 0.0.0.0 --port 8000"]
