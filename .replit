modules = ["nodejs-20", "python-3.11"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PYTHONPATH=.pythonlibs python -m uvicorn api:app --host 0.0.0.0 --port 8000"

[[ports]]
localPort = 8000
externalPort = 80

[deployment]
deploymentTarget = "autoscale"
build = ["sh", "-c", "rm -rf .pythonlibs && PIP_CONFIG_FILE=/dev/null python -m pip install --target .pythonlibs -r requirements.txt && cd frontend && npm ci && npm run build"]
run = ["sh", "-c", "PYTHONPATH=.pythonlibs python -m uvicorn api:app --host 0.0.0.0 --port 8000"]
